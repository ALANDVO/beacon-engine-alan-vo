# Application
APP_NAME=beacon-engine
APP_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=true

# Database
DATABASE_URL=sqlite+aiosqlite:///./data/beacon.db
DATABASE_ECHO=false

# API
API_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Demo Mode (local development only - NEVER enable in production)
DEMO_MODE=true
DEMO_USER_ID=demo-user
DEMO_USER_ROLES=admin,operator,viewer

# OIDC / Keycloak (used when DEMO_MODE=false)
OIDC_ISSUER_URL=http://localhost:8080/realms/beacon-engine
OIDC_CLIENT_ID=beacon-engine
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=http://localhost:5173/callback
OIDC_SCOPES=openid,profile,email,roles

# LLM (optional)
LLM_API_KEY=
LLM_PROVIDER=openai-compatible
LLM_MODEL=
LLM_BASE_URL=

# Build
BUILD_WORKSPACE=./data/builds
MAX_CONCURRENT_BUILDS=2